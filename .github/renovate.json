{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "baseBranches": ["main"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on Monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "separateMinorPatch": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Internal workspace packages \u2014 resolved via pnpm workspace:* protocol",
      "matchPackageNames": ["@mono/**"],
      "enabled": false
    },
    {
      "description": "better-auth ecosystem \u2014 must move together (renovate's monorepo registry doesn't know about better-auth yet, and version skew between its packages breaks auth)",
      "matchPackageNames": [
        "better-auth",
        "@better-auth/**",
        "better-call",
        "@better-fetch/**"
      ],
      "groupName": "better-auth",
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Vercel AI SDK ecosystem \u2014 not in renovate's monorepo registry",
      "matchPackageNames": ["ai", "@ai-sdk/**"],
      "groupName": "ai-sdk"
    },
    {
      "description": "Drizzle ecosystem \u2014 not in renovate's monorepo registry",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit", "drizzle-zod"],
      "groupName": "drizzle"
    },
    {
      "description": "Inngest ecosystem \u2014 not in renovate's monorepo registry",
      "matchPackageNames": ["inngest", "@inngest/**"],
      "groupName": "inngest"
    },
    {
      "description": "Native-binding packages \u2014 extra-long release age (a broken native binary breaks every CSS build)",
      "matchPackageNames": ["lightningcss", "lightningcss-*"],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Major updates: individual PRs always",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    }
  ]
}
