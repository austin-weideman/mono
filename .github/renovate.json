{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "baseBranches": ["dev"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on Monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "separateMinorPatch": true,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Disable internal workspace packages (resolved via pnpm workspace:* protocol)",
      "matchPackageNames": ["@microlearn/**"],
      "enabled": false
    },
    {
      "description": "All patch updates → one PR",
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch updates"
    },
    {
      "description": "All minor updates → one PR",
      "matchUpdateTypes": ["minor"],
      "groupName": "all minor updates"
    },
    {
      "description": "Major updates: individual PRs",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    }
  ]
}
