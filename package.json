{
  "name": "mono",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "rebuild-repo": "pnpm clean:workspaces && pnpm clean && pnpm install && pnpm build",
    "auth:generate": "pnpm -F @mono/auth generate",
    "db:generate": "pnpm -F @mono/db generate",
    "db:migrate": "pnpm -F @mono/db migrate",
    "db:push": "pnpm -F @mono/db push",
    "db:studio": "pnpm -F @mono/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @mono/nextjs...",
    "inngest:dev": "npx inngest-cli@latest dev",
    "start": "pnpm -F @mono/nextjs start",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue --force -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue --force -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck --force",
    "ui-add": "turbo run ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@mono/prettier-config": "workspace:*",
    "@turbo/gen": "2.9.6",
    "dotenv-cli": "11.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "catalog:",
    "turbo": "2.9.6",
    "typescript": "catalog:"
  },
  "prettier": "@mono/prettier-config"
}
