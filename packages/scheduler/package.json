{
  "name": "@mono/scheduler",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./inngest": {
      "types": "./dist/inngest/index.d.ts",
      "default": "./src/inngest/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@mono/core-types": "workspace:*",
    "@mono/db": "workspace:*",
    "@mono/env": "workspace:*",
    "@mono/errors": "workspace:*",
    "@mono/jobs": "workspace:*",
    "@mono/time": "workspace:*",
    "drizzle-orm": "catalog:",
    "inngest": "catalog:",
    "rrule": "2.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mono/eslint-config": "workspace:*",
    "@mono/prettier-config": "workspace:*",
    "@mono/testing": "workspace:*",
    "@mono/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.5"
  },
  "prettier": "@mono/prettier-config"
}
