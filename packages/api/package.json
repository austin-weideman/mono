{
  "name": "@mono/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@mono/attachment": "workspace:*",
    "@mono/auth": "workspace:*",
    "@mono/billing": "workspace:*",
    "@mono/conversation": "workspace:*",
    "@mono/core-types": "workspace:*",
    "@mono/db": "workspace:*",
    "@mono/experiment": "workspace:*",
    "@mono/user": "workspace:*",
    "@mono/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mono/eslint-config": "workspace:*",
    "@mono/prettier-config": "workspace:*",
    "@mono/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@mono/prettier-config"
}
