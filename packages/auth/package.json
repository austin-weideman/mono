{
  "name": "@mono/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "generate": "better-auth generate --config script/auth-cli.ts --output ../db/src/auth-schema.ts --yes",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mono/db": "workspace:*",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@mono/eslint-config": "workspace:*",
    "@mono/prettier-config": "workspace:*",
    "@mono/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@mono/prettier-config"
}
