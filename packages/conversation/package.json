{
  "name": "@microlearn/conversation",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@microlearn/core-types": "workspace:*",
    "@microlearn/db": "workspace:*",
    "@microlearn/errors": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@microlearn/eslint-config": "workspace:*",
    "@microlearn/prettier-config": "workspace:*",
    "@microlearn/testing": "workspace:*",
    "@microlearn/tsconfig": "workspace:*",
    "ai": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "ai": ">=6.0.170"
  },
  "prettier": "@microlearn/prettier-config"
}
