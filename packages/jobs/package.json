{
  "name": "@mono/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./events/conversation": {
      "types": "./dist/events/conversation/index.d.ts",
      "default": "./src/events/conversation/index.ts"
    },
    "./events/scheduler": {
      "types": "./dist/events/scheduler/index.d.ts",
      "default": "./src/events/scheduler/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@mono/env": "workspace:*",
    "inngest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mono/eslint-config": "workspace:*",
    "@mono/prettier-config": "workspace:*",
    "@mono/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@mono/prettier-config"
}
